font-family = JetBrains Mono
font-family = Hack Nerd Font Mono
font-size = 15
adjust-cell-width = 2%

background = #00121b
foreground = #eef6fb
cursor-color = #eaeaea
cursor-text = #000000
selection-background = #4e6a78
selection-foreground = #e7ebed

palette = 0=#2f4048
palette = 1=#fc3841
palette = 2=#6899e8
palette = 3=#fed032
palette = 4=#385ebc
palette = 5=#fc226e
palette = 6=#59ffd1
palette = 7=#ffffff
palette = 8=#a1b0b8
palette = 9=#fc746d
palette = 10=#adf7be
palette = 11=#fee16c
palette = 12=#82cef0
palette = 13=#fc669b
palette = 14=#9affe6
palette = 15=#ffffff

cursor-style = block
cursor-style-blink = false

window-width = 120
window-height = 25
window-padding-x = 5
window-padding-y = 2
macos-option-as-alt = left
confirm-close-surface = false
scrollback-limit = 100000000
mouse-hide-while-typing = true

keybind = cmd+k=text:clear\n
macos-titlebar-style = transparent
window-padding-balance = true
window-padding-color = extend-always
